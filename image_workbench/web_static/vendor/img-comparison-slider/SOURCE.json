  "modifications": "index.js includes the two documented lifecycle substitutions below. index.upstream.js and styles.css are byte-identical to the npm 8.0.7 archive. The npm package omits LICENSE; the license is copied from the matching official GitHub release tag.",
  "local_patch": {
    "reason": "Upstream creates an unreferenced ResizeObserver per connection and does not disconnect it on removal. Retain and disconnect that observer so closing comparisons releases detached instances. Reconnection creates and observes with a fresh observer.",
    "scope": "Only ResizeObserver lifecycle; no image, drag, layout, or keyboard behavior changes.",
    "substitutions": [
      {
        "before": "new ResizeObserver(this.resetDimensions).observe(this)",
        "after": "this.resizeObserver&&this.resizeObserver.disconnect(),this.resizeObserver=new ResizeObserver(this.resetDimensions),this.resizeObserver.observe(this)"
      },
      {
        "before": "disconnectedCallback(){this.transitionTimer&&window.clearTimeout(this.transitionTimer)}",
        "after": "disconnectedCallback(){this.resizeObserver&&(this.resizeObserver.disconnect(),this.resizeObserver=null),this.transitionTimer&&window.clearTimeout(this.transitionTimer)}"
      }
    ]
  }
