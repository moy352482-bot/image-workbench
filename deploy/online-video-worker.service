[Unit]
Description=Image Workbench online video worker
After=network-online.target image-workbench.service
Wants=network-online.target

[Service]
Type=simple
User=image-workbench
Group=image-workbench
WorkingDirectory=/opt/image-workbench/current
Environment=IMAGE_WORKBENCH_ONLINE_VIDEO_CONFIG=/etc/image-workbench-online-video.json
ExecStart=/opt/image-workbench/current/.venv/bin/python -m image_workbench.online_video_worker
Restart=always
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
