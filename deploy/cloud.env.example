# Generate a random worker secret before use. Browser login uses personal accounts.
IMAGE_WORKBENCH_PUBLIC_ORIGIN=https://images.example.com
IMAGE_WORKBENCH_WORKER_TOKEN=REPLACE_WITH_RANDOM_WORKER_TOKEN
# Explicit admission policy for controlled beta. Existing accounts retain access.
IMAGE_WORKBENCH_REGISTRATION_MODE=invite
IMAGE_WORKBENCH_MAX_ACCOUNTS=100
# Optional operating budgets. Zero disables a limit; these do not represent money.
IMAGE_WORKBENCH_MAX_PENDING_PER_ACCOUNT=3
IMAGE_WORKBENCH_MAX_PENDING_TOTAL=30
IMAGE_WORKBENCH_MAX_DAILY_SUBMITTED_CREDIT=2000
# Remote execution slots, 1..32. Uncertain jobs still occupy a slot.
# Account means a website account, not an upstream ChatGPT account.
IMAGE_WORKBENCH_MAX_ACTIVE_TOTAL=1
IMAGE_WORKBENCH_MAX_ACTIVE_PER_ACCOUNT=1
